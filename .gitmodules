	path = vim/pack/plugins/start/nerdtree-git-plugin
	url = https://github.com/Xuyuanp/nerdtree-git-plugin
[submodule "vim/pack/colors/start/one"]
	path = vim/pack/colors/start/one
	url = https://github.com/rakr/vim-one.git
[submodule "vim/pack/plugins/start/vim-alloy"]
	path = vim/pack/plugins/start/vim-alloy
