[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "dotbot-plugins/dotbot-git"]
	path = dotbot-plugins/dotbot-git
	url = https://github.com/DrDynamic/dotbot-git.git
[submodule "dotbot-plugins/dotbot_plugin_aptget"]
	path = dotbot-plugins/dotbot_plugin_aptget
	url = https://github.com/dein0s/dotbot_plugin_aptget.git
[submodule "zsh/zinit/bin"]
	path = zsh/zinit/bin
	url = https://github.com/zdharma/zinit.git
