// https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
// Info lines carried over from the old neofetch config:
// Host, packages, resolution, DE, WM, and theme stay off.
// Disk (/), Local IP, and Public IP stay on. Color blocks stay off.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        {
            "type": "disk",
            "folders": ["/"]
        },
        "localip",
        {
            "type": "publicip",
            "timeout": 2000
        },
        {
            "type": "custom",
            "format": "z = quick driectory change, zz = interactive, s = search/show"
        }
    ]
}
